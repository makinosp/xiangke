# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Godot auto-generated UID files (machine-specific, do not track)
*.uid

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# GDExtension native libraries (build artifacts from extensions/)
addons/gdext/*.dylib
addons/gdext/*.so
addons/gdext/*.dll
